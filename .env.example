# ==============================================
# Web - Runtime configuration
# All values are blank. Fill them using the placeholder formats; leave unused optional settings empty.
# ==============================================
# Google Analytics ID. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity ID. Format: XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=
# Browser-accessible API URL. Format: https://<api-host>/api
NEXT_PUBLIC_API_URL=
# Static asset origin. Format: https://<assets-host>
NEXT_PUBLIC_STATIC_ASSETS_ORIGIN=
# Public Wiki URL prefix. Format: https://<wiki-host>; pages append /docs.
NEXT_PUBLIC_OPENSCIENCE_WIKI_URL_PREFIX=
# Server-accessible API URL. Format: http://<api-host>:<api-port>/api
# Defaults to NEXT_PUBLIC_API_URL when empty. The API is provided by an external service.
INTERNAL_API_URL=
# Server-accessible Wiki URL prefix. Format: http://<wiki-service>:<wiki-port>
# Compose uses the bundled Wiki service address when this value is empty.
OPENSCIENCE_WIKI_INTERNAL_URL_PREFIX=
# Site URL. Format: https://<site-host>
SITE_DOMAIN=
